
/**
 * Bishops Hull Hub Security Rules
 *
 * Core Philosophy:
 * Public data (initiatives, gallery, and page content) is globally readable.
 * Booking enquiries are public for submission (create) but managed only by admins.
 * The Security Team can perform a one-time "Review" action via a public tokenized path.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) ||
        request.auth.token.email == 'bishopshullhub@gmail.com'
      );
    }

    function isExistingAdmin() {
      return isAdmin() && resource != null;
    }

    function matchesPathId(id) {
      return request.resource.data.id == id;
    }

    function idIsImmutable() {
      return request.resource.data.id == resource.data.id;
    }

    // --- Collection Rules ---

    match /booking_enquiries/{enquiryId} {
      // Admins have full access
      allow get, list: if isAdmin();
      
      // Public needs to GET the specific enquiry to show the review summary
      allow get: if true;

      // Submission
      allow create: if isSignedIn() && matchesPathId(enquiryId);
      
      // Update: Admin can update anything.
      // Security Team (public) can ONLY update the 'status' to 'Reviewed'.
      // Hirer (public) can submit hire confirmation if confirmationStatus moves Sent -> Submitted.
      allow update: if (isExistingAdmin() && idIsImmutable()) || (
        request.resource.data.status == 'Reviewed' &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.name == resource.data.name // Ensure other data stays consistent
      ) || (
        request.resource.data.confirmationStatus == 'Submitted' &&
        resource.data.confirmationStatus == 'Sent' &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.dateRequired == resource.data.dateRequired &&
        request.resource.data.emailAddress == resource.data.emailAddress &&
        request.resource.data.status == resource.data.status
      );

      allow delete: if isExistingAdmin();
    }

    match /community_initiatives/{initiativeId} {
      allow read: if true;
      allow create: if isAdmin() && matchesPathId(initiativeId);
      allow update: if isExistingAdmin() && idIsImmutable();
      allow delete: if isExistingAdmin();
    }

    match /gallery_images/{imageId} {
      allow read: if true;
      allow create: if isAdmin() && matchesPathId(imageId);
      allow update: if isExistingAdmin() && idIsImmutable();
      allow delete: if isExistingAdmin();
    }

    match /page_contents/{contentId} {
      allow read: if true;
      allow create: if isAdmin() && matchesPathId(contentId);
      allow update: if isExistingAdmin() && idIsImmutable();
      allow delete: if isExistingAdmin();
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow create: if isAdmin() && matchesPathId(faqId);
      allow update: if isExistingAdmin() && idIsImmutable();
      allow delete: if isExistingAdmin();
    }

    match /security_team/{contactId} {
      // Public `get` is required for the login Activate flow to pre-check
      // whether an email is on the allowlist before creating an Auth account.
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }

    match /admins/{adminId} {
      // Same Activate-flow allowance: anyone can probe a single doc by email,
      // but only existing admins can list or modify the collection.
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }
  }
}
